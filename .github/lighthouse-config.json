{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 3000",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/aftercare",
        "http://localhost:3000/privatlivspolitik"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:3000/$",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "first-contentful-paint": [
              "error",
              {
                "maxNumericValue": 1800
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "interactive": [
              "error",
              {
                "maxNumericValue": 3500
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 650
              }
            ],
            "uses-text-compression": "off",
            "is-crawlable": "off"
          }
        },
        {
          "matchingUrlPattern": "/(aftercare|privatlivspolitik)",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "uses-text-compression": "off",
            "is-crawlable": "off"
          }
        }
      ],
      "aggregationMethod": "pessimistic"
    }
  }
}
